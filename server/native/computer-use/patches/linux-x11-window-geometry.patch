+    // Require live geometry; do not return zero dimensions that produce invalid
+    // screenshot-to-desktop coordinate mappings. The window ID is a numeric argv.
+    fn x11_window_bounds(window_id: u32) -> Option<serde_json::Value> {
+        let output = Command::new("xdotool")
+            .args(["getwindowgeometry", "--shell", &window_id.to_string()])
+            .output().ok()?;
+        if !output.status.success() { return None; }
+        let text = String::from_utf8_lossy(&output.stdout);
+        let coordinate = |key: &str| -> Option<i32> {
+            text.lines().find_map(|line| line.strip_prefix(key)?.parse::<i32>().ok())
+        };
+        let x = coordinate("X=")?;
+        let y = coordinate("Y=")?;
+        let width = coordinate("WIDTH=")?;
+        let height = coordinate("HEIGHT=")?;
+        if width <= 0 || height <= 0 { return None; }
+        Some(serde_json::json!({ "x": x, "y": y, "width": width, "height": height }))
+    }
