* text=auto
*.sh text eol=lf
# Unified-diff context lines preserve one space for an empty source line.
server/native/computer-use/patches/*.patch text eol=lf whitespace=-blank-at-eol
server/native/computer-use/**/*.node -text
android/gradlew text eol=lf
*.png binary
*.gif binary
*.jar binary
# Preserve V7 authoring receipt bytes; serve model manifests identically on Windows/Linux.
outputs/avatars/akari-cubism-v7/authoring-receipt.json -text whitespace=cr-at-eol
outputs/avatars/akari-cubism-v7/pack-receipt.json text eol=lf
public/avatars/akari-cubism-v7/*.json text eol=lf
server/native/music-mcp/** -text
# The native reviewer verifies the official catalog's original SHA256 at runtime.
server/native/codex-review/** -text -whitespace
# Skill provenance validates original bytes on Windows and Linux.
server/native/skills/** -text -whitespace
