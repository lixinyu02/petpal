{
  "name": "petpal",
  "version": "0.9.11",
  "private": true,
  "type": "module",
  "description": "小伴 PetPal — 四端个人桌宠与 Codex 助手",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --config desktop/electron-builder.yml --dir",
    "desktop:win": "node scripts/build-windows.mjs",
    "desktop:linux": "npm run build && electron-builder --config desktop/electron-builder.yml --linux AppImage deb",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@jackwener/opencli": "1.8.8",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@openai/codex": "0.143.0",
    "@zavora-ai/computer-use-mcp": "7.4.0",
    "ajv": "8.20.0",
    "compression": "1.8.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "three": "0.180.0",
    "unified": "11.0.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "ag-psd": "31.0.2",
    "concurrently": "^9.2.1",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "pngjs": "7.0.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.6"
  }
}
